@using Nop.Web.Areas.Admin.Model
@model OfferInfoModel
@{
    //page title
    ViewBag.PageTitle = T("Admin.OfferInfos.AddNew").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("OfferInfos");
    Layout = "_AdminLayout";
}
<form asp-controller="OfferInfo" asp-action="Create" method="post" id="OfferInfo-form">
    <div class="content-header clearfix">
         <h1 class="float-left">
            @T("Admin.OfferInfos.AddNew")
             <small>
                <i class="fas fa-arrow-circle-left"></i>
            <a asp-action="List">@T("Admin.OfferInfos.BackToList")</a>
            </small>
         </h1> 
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.SaveContinue")
            </button>
@*             @await Component.InvokeAsync(typeof(AdminWidgetViewComponent), new { widgetZone = AdminWidgetZones.CategoryDetailsButtons, additionalData = Model })
 *@        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdate", Model)
</form>