@model EmployeeModel

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Name" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Name" />
            <span asp-validation-for="Name"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Designation" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Designation" />
            <span asp-validation-for="Designation"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="PhoneNo" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="PhoneNo" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="CountryId" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="CountryId" asp-items="Model.AvailableCountries" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="StateId" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="StateId" asp-items="Model.AvailableStates" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="CityId" />
        </div>
        <div class="col-md-9">
            <nop-select asp-for="CityId" asp-items="Model.AvailableCities" />
        </div>
    </div>
</div>

